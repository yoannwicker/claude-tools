# Un passage de tidy-watch (plugin git-tidy de claude-tools), lancé par tidy-watch.timer.
[Unit]
Description=tidy-watch : PR approuvées (git-tidy)

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/tidy-watch poll
# Les analyses en fond et les notifications en attente de clic survivent au passage
KillMode=process
