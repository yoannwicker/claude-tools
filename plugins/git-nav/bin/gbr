#!/usr/bin/env bash
# gbr — branches git : trouver, afficher, se placer dessus. Socle du skill Claude /br.
#   gbr [nom | recherche]   interactif : menu, affichage, puis où se placer
#   gbr list [recherche]    branches locales et origin dédoublonnées, hors branche par
#                           défaut, dernier commit d'abord (50 max), une par ligne :
#                           nom<TAB>où (local|origin|local+origin)<TAB>date<TAB>auteur<TAB>suivi
#   gbr view <branche>      état vs la branche par défaut, commits, fichiers, PR liée
#   gbr where <branche>     situation locale, en clé=valeur : branch, local, remote,
#                           current, worktree, dirty
#   gbr worktree <branche>  crée ou réutilise <racine>/.claude/worktrees/<branche, / → ->,
#                           n'écrit que son chemin sur stdout
#   gbr checkout <branche>  bascule le dossier courant sur la branche (git switch)
#   gbr cleanup [--dry-run | --yes] [--local] [--pr <n>] [<branche>]
#                           ménage d'une branche mergée : worktree, branche locale,
#                           sauvegardes backup/<branche>-*, branche distante (sauf --local).
#                           Vérifie d'abord que rien ne sera perdu ; --dry-run affiche le
#                           plan (code 1 si bloqué), --yes l'exécute, sans les deux demande.
#                           --pr : branche de cette PR ; sans branche : la branche courante
# Un nom peut être donné avec ou sans « origin/ ». La fonction gbr de
# ~/.config/shell/git-tools.sh enveloppe le mode interactif pour faire le cd final.
set -uo pipefail
PROG=gbr
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/git-tools.sh" || exit 1

has_local()  { git show-ref --verify --quiet "refs/heads/$1"; }
has_remote() { git show-ref --verify --quiet "refs/remotes/origin/$1"; }

# br <nom> : nom de branche normalisé (sans origin/), qui doit exister.
br() {
    local b=${1:-}
    b=${b#origin/}
    [[ -n "$b" ]] || die "nom de branche attendu."
    has_local "$b" || has_remote "$b" || die "branche inconnue : $b"
    echo "$b"
}

default_branch() {
    local d
    if d=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null); then
        echo "${d#origin/}"; return
    fi
    for d in main master; do
        if has_local "$d" || has_remote "$d"; then echo "$d"; return; fi
    done
    echo main
}

# ref <branche> : la branche locale si elle existe, sinon origin/<branche>.
ref() { if has_local "$1"; then echo "$1"; else echo "origin/$1"; fi; }

cmd_list() {
    local q def
    q=$(tr '[:upper:]' '[:lower:]' <<<"$*")
    def=$(default_branch)
    git fetch --quiet --prune origin 2>/dev/null || true
    git for-each-ref --sort=-committerdate \
        --format='%(refname)%09%(committerdate:short)%09%(authorname)%09%(upstream:track)' \
        refs/heads refs/remotes/origin |
    awk -F'\t' -v def="$def" -v q="$q" '
        {
            if ($1 ~ /^refs\/heads\//) { name = substr($1, 12); kind = "local" }
            else                       { name = substr($1, 21); kind = "origin" }
            if (name == "HEAD" || name == def) next
            if (q != "" && index(tolower(name), q) == 0) next
            if (!(name in where)) { order[++n] = name; date[name] = $2; author[name] = $3; where[name] = kind }
            else if (where[name] != kind) where[name] = "local+origin"
            if (kind == "local") track[name] = $4
        }
        END {
            for (i = 1; i <= n && i <= 50; i++) {
                b = order[i]
                printf "%s\t%s\t%s\t%s\t%s\n", b, where[b], date[b], author[b], track[b]
            }
        }'
}

cmd_view() {
    local b base r ahead behind
    b=$(br "${1:-}") || exit 1
    base=$(default_branch)
    has_remote "$base" && base="origin/$base"
    r=$(ref "$b")
    read -r behind ahead < <(git rev-list --left-right --count "$base...$r")

    echo "branche : $b ($(has_local "$b" && echo locale)$(has_local "$b" && has_remote "$b" && echo " + ")$(has_remote "$b" && echo origin))"
    if has_local "$b"; then
        local up
        up=$(git for-each-ref --format='%(upstream:short) %(upstream:track)' "refs/heads/$b")
        [[ -n "${up// }" ]] && echo "suivi : $up"
    fi
    echo "dernier commit : $(git log -1 --format='%cr, %an' "$r")"
    echo "par rapport à $base : $ahead commit(s) d'avance, $behind de retard"
    if command -v gh >/dev/null; then
        gh pr list --head "$b" --state all --json number,title,state,url \
            --jq '.[] | "PR #\(.number) [\(.state)] \(.title) — \(.url)"' 2>/dev/null
    fi
    echo
    echo "commits ($base..$r, 30 derniers) :"
    git log --oneline --no-decorate -30 "$base..$r"
    echo
    git diff --stat "$base...$r" | tail -n 20
}

cmd_where() {
    local b
    b=$(br "${1:-}") || exit 1
    echo "branch=$b"
    echo "local=$(has_local "$b" && echo yes || echo no)"
    echo "remote=$(has_remote "$b" && echo yes || echo no)"
    echo "current=$(git rev-parse --abbrev-ref HEAD)"
    echo "worktree=$(wt_of "$b")"
    echo "dirty=$(git status --porcelain | wc -l)"
}

# wt_name <branche> / refspec <branche> : dossier du worktree et ce qu'il faut fetcher.
wt_name() { echo "${1//\//-}"; }
refspec() { if has_remote "$1"; then echo "$1"; fi; }

cmd_worktree() {
    local b
    b=$(br "${1:-}") || exit 1
    wt_add "$(wt_name "$b")" "$b" "$(refspec "$b")"
}

cmd_checkout() {
    local b
    b=$(br "${1:-}") || exit 1
    git switch "$b" && git status -sb
}

# backups <branche> : sauvegardes de /git-tidy:commits, backup/<branche>-* (/ gardé ou en -).
backups() {
    git for-each-ref --format='%(refname:short)' "refs/heads/backup/$1-*" "refs/heads/backup/${1//\//-}-*" | sort -u
}

# cleanup_plan <branche> <local seulement 0|1> : vérifie que la branche peut être
# supprimée sans perte et remplit PLAN (actions, dans l'ordre) et BLOCK (raison d'arrêt).
cleanup_plan() {
    local b=$1 local_only=$2 base pr state oid n wt verdict detail current
    PLAN=() BLOCK="" WT="" BACKUPS=()
    base=$(default_branch)
    git fetch --quiet --prune origin 2>/dev/null || true

    if ! has_local "$b" && ! has_remote "$b" && [[ -z "$(wt_of "$b")" ]]; then
        mapfile -t BACKUPS < <(backups "$b")
        (( ${#BACKUPS[@]} )) || { BLOCK="rien à supprimer : $b n'existe plus (ni locale, ni origin, ni worktree)."; return; }
        PLAN+=("supprimer les sauvegardes ${BACKUPS[*]}")
        return
    fi
    [[ "$b" == "$base" ]] && { BLOCK="$b est la branche par défaut."; return; }

    # 1. Mergée ? PR mergée, ou sans PR, contenue dans la base (locale ou origin).
    pr=""
    command -v gh >/dev/null && pr=$(gh pr list --head "$b" --state all -L 1 \
        --json number,state,headRefOid --jq '.[] | "\(.number) \(.state) \(.headRefOid)"' 2>/dev/null)
    if [[ -n "$pr" ]]; then
        read -r n state oid <<<"$pr"
        [[ "$state" == MERGED ]] || { BLOCK="la PR #$n de $b est $state, pas mergée."; return; }
        if has_local "$b"; then
            git cat-file -e "$oid^{commit}" 2>/dev/null || git fetch --quiet origin "pull/$n/head" 2>/dev/null
            if ! git cat-file -e "$oid^{commit}" 2>/dev/null; then
                BLOCK="impossible de lire le dernier commit de la PR #$n ($oid) pour vérifier $b."; return
            fi
            if [[ -n "$(git rev-list "$oid..$b")" ]]; then
                BLOCK="$b a des commits absents de la PR #$n mergée :"$'\n'"$(git log --oneline --no-decorate "$oid..$b")"
                return
            fi
        fi
        PLAN+=("vérifié : PR #$n mergée, rien sur $b hors de la PR")
    else
        local r; r=$(ref "$b")
        if [[ -z "$(git rev-list "$base..$r" 2>/dev/null)" ]] \
            || { has_remote "$base" && [[ -z "$(git rev-list "origin/$base..$r")" ]]; }; then
            PLAN+=("vérifié : pas de PR, $b entièrement contenue dans $base")
        else
            BLOCK="pas de PR pour $b et elle n'est pas contenue dans $base."; return
        fi
    fi

    # 2. Worktree : supprimé s'il est libre, sinon on s'arrête (la branche y est checkoutée).
    WT=$(wt_of "$b")
    if [[ -n "$WT" ]]; then
        IFS=$'\t' read -r verdict _ _ detail < <("$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/worktree-scan" | awk -F'\t' -v p="$WT" '$2 == p')
        case "$verdict" in
            free)    PLAN+=("supprimer le worktree $WT") ;;
            current) BLOCK="on est dans le worktree de $b ($WT) : en sortir d'abord."; return ;;
            main)    ;;  # branche checkoutée dans le dépôt principal : traitée ci-dessous
            *)       BLOCK="worktree $WT gardé ($verdict : $detail), $b ne peut pas être supprimée."; return ;;
        esac
    fi

    # 3. Branche courante ici : passer sur la base à jour (jamais de stash).
    current=$(git rev-parse --abbrev-ref HEAD)
    if [[ "$current" == "$b" ]]; then
        [[ -n "$(git status --porcelain)" ]] && { BLOCK="$b est la branche courante et a des modifications non commitées."; return; }
        PLAN+=("passer sur $base (git switch, git pull --ff-only)")
    fi

    has_local "$b" && PLAN+=("supprimer la branche locale $b")
    mapfile -t BACKUPS < <(backups "$b")
    (( ${#BACKUPS[@]} )) && PLAN+=("supprimer les sauvegardes ${BACKUPS[*]}")
    if has_remote "$b"; then
        if (( local_only )); then PLAN+=("garder origin/$b (--local)")
        else PLAN+=("supprimer origin/$b"); fi
    fi
}

cmd_cleanup() {
    local mode=ask local_only=0 pr="" b="" base root
    while (( $# )); do
        case "$1" in
            --dry-run) mode=dry ;;
            --yes)     mode=yes ;;
            --local)   local_only=1 ;;
            --pr)      pr=${2:-}; shift ;;
            -*)        die "option inconnue : $1" ;;
            *)         b=${1#origin/} ;;
        esac
        shift
    done
    if [[ -n "$pr" ]]; then
        b=$(gh pr view "$pr" --json headRefName --jq .headRefName) || die "PR introuvable : $pr"
    fi
    [[ -n "$b" ]] || b=$(git rev-parse --abbrev-ref HEAD)

    cleanup_plan "$b" "$local_only"
    echo "ménage de $b :"
    (( ${#PLAN[@]} )) && printf '  - %s\n' "${PLAN[@]}"
    if [[ -n "$BLOCK" ]]; then echo "bloqué : $BLOCK"; exit 1; fi
    case "$mode" in
        dry) exit 0 ;;
        ask)
            case "$(pick "Ménage" "Tout supprimer" "Local seulement" "Annuler")" in
                "Tout supprimer")  ;;
                "Local seulement") local_only=1 ;;
                *) echo "annulé."; exit 0 ;;
            esac ;;
    esac

    base=$(default_branch)
    root=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
    if [[ -n "$WT" && "$WT" != "$root" ]]; then
        git -C "$root" worktree remove "$WT" || exit 1
        git -C "$root" worktree prune
    fi
    if [[ "$(git -C "$root" rev-parse --abbrev-ref HEAD)" == "$b" ]]; then
        git -C "$root" switch "$base" || exit 1
        git -C "$root" pull --ff-only || echo "(pull --ff-only impossible, $base laissée telle quelle)" >&2
    fi
    has_local "$b" && { git branch -D "$b" || exit 1; }
    local k; for k in "${BACKUPS[@]}"; do git branch -D "$k" || exit 1; done
    if has_remote "$b" && (( ! local_only )); then git push origin --delete "$b" || exit 1; fi
    echo "→ $(git rev-parse --abbrev-ref HEAD) · $PWD"
}

cmd_interactive() {
    local query="$*" b=""

    # 1. Trouver la branche : nom exact, sinon recherche
    if [[ -n "$query" ]] && { has_local "${query#origin/}" || has_remote "${query#origin/}"; }; then
        b=${query#origin/}
    else
        local out lines=()
        out=$(cmd_list "$query") || exit 1
        [[ -n "$out" ]] && mapfile -t lines < <(awk -F'\t' '{
            printf "%s  (%s · %s · %s%s)\n", $1, $2, $3, $4, ($5 != "" ? " " $5 : "") }' <<<"$out")
        case ${#lines[@]} in
            0) die "aucune branche${query:+ pour « $query »}." ;;
            1) b=${lines[0]} ;;
            *) b=$(pick "Branche" "${lines[@]}"); [[ -z "$b" ]] && exit 0 ;;
        esac
        b=${b%%  *}
    fi

    # 2. L'afficher, 3. se placer dessus
    cmd_view "$b"
    echo
    place "$b" "$(wt_name "$b")" "$(refspec "$b")" cmd_checkout "$b"
}

case "${1:-}" in
    -h|--help) sed -n '2,21p' "$0"; exit 0 ;;
esac
in_repo

case "${1:-}" in
    list)     shift; cmd_list "$@" ;;
    view)     shift; cmd_view "$@" ;;
    where)    shift; cmd_where "$@" ;;
    worktree) shift; cmd_worktree "$@" ;;
    checkout) shift; cmd_checkout "$@" ;;
    cleanup)  shift; cmd_cleanup "$@" ;;
    *)        cmd_interactive "$@" ;;
esac
