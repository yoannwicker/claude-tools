{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "bash \"${CLAUDE_PLUGIN_ROOT}/cursor/scripts/cursor-watch.sh\" start"
      }
    ],
    "sessionEnd": [
      {
        "command": "bash \"${CLAUDE_PLUGIN_ROOT}/cursor/scripts/cursor-watch.sh\" stop"
      }
    ]
  }
}
