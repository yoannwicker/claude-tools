{
  "description": "Sans pr-comments",
  "model": "opus",
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "padding": 0,
    "refreshInterval": 10
  },
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "theme": "dark",
  "autoContinueAtUsageLimit": false,
  "inputNeededNotifEnabled": true,
  "enabledPlugins": {
    "pr-comments@claude-tools": false,
    "intellij@claude-tools": true,
    "profiles@claude-tools": true,
    "git-nav@claude-tools": true,
    "notify@claude-tools": true,
    "herdr-session@claude-tools": true,
    "build-brief@claude-tools": true
  }
}
