#!/usr/bin/env bash
# claude-profile — profils Claude Code : une surcharge du settings.json de référence, générée en un
# dossier de config depuis ~/.claude, où seul settings.json diffère, lancé avec CLAUDE_CONFIG_DIR.
#   claude-profile list | current | show [<nom>] | new <nom> [description…] | plugin <nom> <plugin> on|off | generate <nom>|--all | check <nom> | --help
#   claude-profile mcp <nom> <serveur|url|claude.ai> on|off | mcp-scan : MCP coupés (deniedMcpServers), serveurs connus
#   claude-profile default [<nom>|--unset] : profil par défaut (celui des nouvelles sessions de run), affiché ou changé
#   claude-profile project [<nom>|--unset] : profil du projet courant (.claude/profile.local), prioritaire sur le défaut
#   claude-profile switch <nom> [arguments claude…] | run [arguments claude…] | request <nom> <session>
#   claude-profile base <nom> [update] : base d'un profil (dépôt et son installeur), affichée ou mise à jour
#   Profil de référence (reference) : ~/.claude/settings.json, ~/.claude sans profil.
#   Profil : profiles/<nom>.json du dépôt, { description, enabledPlugins, deniedMcpServers,
#   disableClaudeAiConnectors } ; son settings.json est le profil de référence avec chacune de ces
#   sections remplacée en entier par celle du profil.
#   Profil avec base ({ base: { repo, install, disabledPlugins }, … }) : part de la config que
#   l'installeur du dépôt produit dans un HOME à part (~/.claude-profiles/.bases/<nom>/), pas de la
#   référence ; ses plugins actifs le restent sauf ceux de disabledPlugins, enabledPlugins s'y ajoute.
#   Dossier généré : ~/.claude-profiles/<nom>/ (tout le reste en liens vers ~/.claude).
#   switch/run lancent claude dans une boucle : /profile <nom> (plugin profiles) y dépose une
#   demande (request) puis quitte, et la boucle relance la même session dans <nom>. run hors
#   profil part sur le profil du projet, sinon le profil par défaut, sinon le profil de référence ; une reprise
#   (--continue, --resume <id>) part sur le dernier profil de la conversation (remember <session>).
set -u
repo=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../.." && pwd)
profiles_dir=$repo/profiles
base=$HOME/.claude
out_root=$HOME/.claude-profiles
main=$base/settings.json
default_file=$out_root/.default
# Profil d'un projet : son nom dans ce fichier, à la racine du projet (non versionné).
project_rel=.claude/profile.local
# .claude/.gitignore généré à côté : ce fichier, et lui-même, hors de git.
project_ignore=$'# claude-profile project : profil local à ce projet, non versionné\nprofile.local\n.gitignore'
# Dernier profil de chaque session, « <session> <profil> » par ligne (claude-profile remember).
sessions_file=$out_root/.sessions
# Clés qu'un profil peut porter : les sections surchargées (remplacées en entier) et sa description.
overridable='["description", "base", "enabledPlugins", "deniedMcpServers", "disableClaudeAiConnectors"]'
# Bases des profils : <nom>/repo (clone), <nom>/home (HOME de l'installeur, sa config dans
# home/.claude), <nom>/settings.json (son settings.json juste après l'installeur : les plugins de la base).
bases_root=$out_root/.bases
# Config de ~/.claude qu'un profil avec base ne reprend pas : elle vient de la base. Le reste
# (identifiants, historique, transcripts, état) reste commun.
own_config="settings.json CLAUDE.md skills rules agents commands hooks plugins output-styles dev-mods"
# Outils de la machine, liés dans le HOME de la base : l'installeur les trouve ou les installe une
# seule fois, dans le vrai HOME. Dossiers créés au besoin ; fichiers et réglages liés s'ils existent.
shared_home_dirs=".local .cache .npm .plannotator .sonar"
shared_home_links=".gitconfig .ssh .volta .config/gh"
# Serveurs MCP connus (nom, url), relevés par claude mcp list (mcp-scan).
mcp_cache=$out_root/.mcp-servers.json
# jq : motif serverUrl (jokers *) en expression régulière ; serveur s ({name, url}) coupé par la
# liste d'entrées deniedMcpServers d (serverName exact, ou serverUrl).
jq_mcp='
  def glob($p): "^" + ($p | gsub("(?<c>[.?+^$(){}|\\[\\]\\\\/])"; "\\\(.c)") | gsub("\\*"; ".*")) + "$";
  def urlmatch($u; $url): $u != null and $url != null and ($url | test(glob($u)));
  def denied($s; $d): any($d[]; .serverName == $s.name or urlmatch(.serverUrl; $s.url));
'

usage() { sed -n '2,21p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }
die() { echo "$*" >&2; exit 2; }

names() { local f; for f in "$profiles_dir"/*.json; do [ -e "$f" ] && basename "$f" .json; done; }

check() {
  [ "$1" = reference ] && return 0
  local f=$profiles_dir/$1.json bad
  [ -f "$f" ] || die "profil inconnu : $1 (profils : reference $(names | tr '\n' ' '))"
  jq -e 'type == "object"' "$f" >/dev/null 2>&1 || die "profil invalide (objet JSON attendu) : $f"
  bad=$(jq -r --argjson ok "$overridable" 'keys - $ok | join(", ")' "$f")
  [ -z "$bad" ] || die "profil $1 : seules $(jq -r 'join(", ")' <<< "$overridable") sont surchargeables (en trop : $bad) : $f"
  jq -e '.base == null or ((.base | type) == "object" and (.base.repo | type) == "string"
         and ((.base.disabledPlugins // []) | type == "array" and all(type == "string")))' "$f" >/dev/null \
    || die "profil $1 : base attendue { repo, install, disabledPlugins: [plugin…] } : $f"
}

# Profil avec base (section base de profiles/<nom>.json).
has_base() { [ "$1" != reference ] && jq -e '.base != null' "$profiles_dir/$1.json" >/dev/null 2>&1; }
base_dir() { echo "$bases_root/$1"; }
# Config produite par l'installeur de la base.
base_conf() { echo "$bases_root/$1/home/.claude"; }
# Plugins installés que voit un profil : ceux de sa base, sinon ceux de ~/.claude.
plugins_file() {
  if has_base "$1"; then echo "$(base_conf "$1")/plugins/installed_plugins.json"; else echo "$base/plugins/installed_plugins.json"; fi
}

# Dépendances déclarées par les plugins activés de $1 ({plugin: bool}), installés selon $2
# (installed_plugins.json), en JSON [{plugin, dep}] ; une dépendance sans marketplace est dans celle
# du plugin.
plugin_deps() {
  local p dir out='[]'
  for p in $(jq -r 'to_entries[] | select(.value) | .key' <<< "$1"); do
    dir=$(jq -r --arg p "$p" '.plugins[$p][0].installPath // empty' "$2" 2>/dev/null)
    [ -n "$dir" ] && [ -f "$dir/.claude-plugin/plugin.json" ] || continue
    out=$(jq -c --argjson out "$out" --arg p "$p" --arg m "${p#*@}" '$out + [(.dependencies // [])[]
      | {plugin: $p, dep: (if type == "string" then (if test("@") then . else "\(.)@\($m)" end) else "\(.name)@\(.marketplace // $m)" end)}]' \
      "$dir/.claude-plugin/plugin.json" 2>/dev/null || echo "$out")
  done
  echo "$out"
}

# Plugins de la base d'un profil, en JSON {plugin: bool} : ceux que l'installeur a activés, leurs
# dépendances (une dépendance ajoutée par une mise à jour du plugin y entre ainsi d'elle-même), et à
# false ceux de base.disabledPlugins, dont les dépendances ne sont pas suivies.
base_plugins() {
  local off on deps i
  off=$(jq -c '.base.disabledPlugins // []' "$profiles_dir/$1.json")
  on=$(jq -c --argjson off "$off" '.enabledPlugins // {} | with_entries(select(.value and (.key | IN($off[]) | not)))' "$(base_dir "$1")/settings.json")
  for i in 1 2 3 4 5; do
    deps=$(plugin_deps "$on" "$(plugins_file "$1")" | jq -c --argjson on "$on" --argjson off "$off" \
      '[.[].dep | select($on[.] == null and (IN($off[]) | not))] | unique')
    [ "$deps" = '[]' ] && break
    on=$(jq -c --argjson d "$deps" '. + ($d | map({(.): true}) | add)' <<< "$on")
  done
  jq -c --argjson off "$off" '. + ($off | map({(.): false}) | add // {})' <<< "$on"
}

# Le profil de référence, lu pour générer un profil : un objet JSON, pas un ancien lien vers un profil généré.
check_main() {
  case "$(readlink -f "$main")" in
    "$out_root"/*) die "$main pointe encore vers un profil généré (ancien modèle) : ./install.sh link le relie au profil de référence du dépôt" ;;
  esac
  jq -e 'type == "object"' "$main" >/dev/null 2>&1 || die "profil de référence illisible (objet JSON attendu) : $main"
}

# Profil par défaut : celui nommé dans ~/.claude-profiles/.default (rien s'il n'y en a pas ou
# s'il n'existe plus).
default_profile() {
  local d
  d=$(cat "$default_file" 2>/dev/null) || return 0
  [ -n "$d" ] && [ -f "$profiles_dir/$d.json" ] && echo "$d"
  return 0
}

# Racine du projet courant : celle du dépôt git, sinon le dossier courant.
project_root() { git rev-parse --show-toplevel 2>/dev/null || pwd; }

# Fichier de profil du projet courant : le plus proche en remontant depuis le dossier courant
# (sans aller jusqu'à $HOME, dont ~/.claude est la config), sinon celui du worktree principal du
# dépôt, que ses autres worktrees reprennent ainsi. Rien s'il n'y en a pas.
project_file() {
  local d=$PWD common
  while [ "$d" != / ] && [ "$d" != "$HOME" ]; do
    [ -f "$d/$project_rel" ] && { echo "$d/$project_rel"; return 0; }
    d=$(dirname "$d")
  done
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 0
  [ "$(basename "$common")" = .git ] && [ -f "$(dirname "$common")/$project_rel" ] && echo "$(dirname "$common")/$project_rel"
  return 0
}

# Profil du projet courant (rien s'il n'y en a pas) ; un profil qui n'existe plus est signalé.
project_profile() {
  local f p
  f=$(project_file)
  [ -n "$f" ] || return 0
  p=$(tr -d '[:space:]' < "$f")
  if [ "$p" = reference ] || [ -f "$profiles_dir/$p.json" ]; then echo "$p"
  elif [ -n "$p" ]; then echo "profil du projet inconnu, ignoré : $p (${f/#$HOME/\~})" >&2; fi
  return 0
}

# Dossier de config d'un profil, vide pour le profil de référence (~/.claude tel quel).
config_dir() { [ "$1" = reference ] || echo "$out_root/$1"; }

# Profil de la session courante, d'après CLAUDE_CONFIG_DIR.
current() {
  case "${CLAUDE_CONFIG_DIR:-}" in
    "$out_root"/*) basename "$CLAUDE_CONFIG_DIR" ;;
    "") echo reference ;;
    *) echo "autre ($CLAUDE_CONFIG_DIR)" ;;
  esac
}

# Dernier profil d'une session (rien si inconnu, ou si le profil n'existe plus).
session_profile() {
  local p
  p=$(awk -v id="$1" '$1 == id { p = $2 } END { print p }' "$sessions_file" 2>/dev/null)
  if [ -n "$p" ] && { [ "$p" = reference ] || [ -f "$profiles_dir/$p.json" ]; }; then echo "$p"; fi
  return 0
}

# Retient le profil de la session courante pour la session <session> (hook de démarrage du
# plugin) ; les 1000 dernières sessions sont gardées.
cmd_remember() {
  [ $# -eq 1 ] || die "usage : claude-profile remember <session>"
  local p tmp
  p=$(current)
  case "$p" in autre*) return 0 ;; esac
  mkdir -p "$out_root"
  tmp=$(mktemp "$out_root/.sessions.XXXXXX")
  { grep -v "^$1 " "$sessions_file" 2>/dev/null | tail -n 999; echo "$1 $p"; } > "$tmp" \
    && mv "$tmp" "$sessions_file" || rm -f "$tmp"
}

# Session reprise par des arguments claude : --resume/-r <id ou chemin du transcript>, sinon
# --continue/-c, la conversation la plus récente du dossier courant (comme claude).
resumed_session() {
  local a prev="" dir
  for a in "$@"; do
    case "$prev" in --resume|-r) case "$a" in -*) ;; *) a=${a##*/}; echo "${a%.jsonl}"; return ;; esac ;; esac
    case "$a" in --resume=*) a=${a#--resume=}; a=${a##*/}; echo "${a%.jsonl}"; return ;; esac
    prev=$a
  done
  for a in "$@"; do
    case "$a" in
      --continue|-c)
        dir=$base/projects/$(pwd | sed 's/[^A-Za-z0-9-]/-/g')
        a=$(ls -t "$dir"/*.jsonl 2>/dev/null | head -n 1)
        [ -n "$a" ] && basename "$a" .jsonl
        return ;;
    esac
  done
}

# settings.json d'un profil : le profil de référence, ses sections surchargées remplacées par celles du profil.
# Avec base : le settings.json de la base (marketplaces : aussi celles ajoutées depuis pour les plugins
# du profil), les sections du profil, et ses plugins ajoutés à ceux de la base.
merged() {
  if [ "$1" = reference ]; then jq . "$main"
  elif has_base "$1"; then
    jq -n --argjson bp "$(base_plugins "$1")" --slurpfile s "$(base_dir "$1")/settings.json" \
       --slurpfile live "$(base_conf "$1")/settings.json" --slurpfile p "$profiles_dir/$1.json" '
      $s[0] + {extraKnownMarketplaces: (($s[0].extraKnownMarketplaces // {}) + ($live[0].extraKnownMarketplaces // {}))}
      + ($p[0] | del(.description, .base, .enabledPlugins))
      + {enabledPlugins: ($bp + ($p[0].enabledPlugins // {}))}'
  else jq -s '.[0] + (.[1] | del(.description))' "$main" "$profiles_dir/$1.json"; fi
}

# Avertissements d'un profil avec base : plugin du profil déjà actif dans la base ou pas installé,
# plugin coupé que la base n'a plus, dépendance coupée d'un plugin actif (qui ne se chargera pas).
base_warnings() {
  local bp snap pf
  bp=$(base_plugins "$1")
  snap=$(base_dir "$1")/settings.json
  pf=$(plugins_file "$1")
  jq -r --argjson bp "$bp" --slurpfile s "$snap" --argjson deps "$(plugin_deps "$bp" "$pf")" \
     --argjson installed "$(jq -c '.plugins // {} | keys' "$pf" 2>/dev/null || echo '[]')" --arg name "$1" '
    (.enabledPlugins // {}) as $own
    | (($s[0].enabledPlugins // {}) | with_entries(select(.value)) | keys) as $snap
    | ($own | to_entries[] | select(.value) | .key
       | if $bp[.] == true then "attention : \(.) est déjà actif dans la base de \($name), à retirer de enabledPlugins"
         elif IN($installed[]) | not then "attention : \(.) n'\''est pas installé dans la base de \($name) : claude-profile base \($name) update"
         else empty end),
      ((.base.disabledPlugins // [])[] | select(IN($snap[]) | not)
       | "attention : \(.) (base.disabledPlugins) n'\''est plus dans la base de \($name)"),
      ($deps[] | select($bp[.dep] == false)
       | "attention : \(.plugin) dépend de \(.dep), coupé dans \($name) : il ne se chargera pas")
  ' "$profiles_dir/$1.json" >&2
}

# Identifiants : lien vers ceux de la base. Claude Code réécrit le fichier par renommage,
# ce qui peut remplacer le lien par un fichier : s'il est plus récent que celui de la base
# (jetons rafraîchis dans le profil), il le remplace, puis le lien est reposé.
repair_credentials() {
  local f=$1/.credentials.json
  [ -f "$f" ] && [ ! -L "$f" ] || return 0
  if [ "$f" -nt "$base/.credentials.json" ]; then
    mv "$f" "$base/.credentials.json" && echo "identifiants du profil reportés dans ~/.claude"
  else
    rm -f "$f"
  fi
}

# Lien $2 -> $1 (cible résolue), sauf sur un vrai dossier, gardé.
link_entry() {
  if [ -d "$2" ] && [ ! -L "$2" ]; then
    echo "conservé (dossier propre au profil) : $2" >&2
    return
  fi
  rm -f "$2"
  ln -s "$(readlink -f "$1")" "$2"
}

generate() {
  local name=$1 dir=$out_root/$1 e n withbase="" conf=""
  check "$name"
  [ "$name" = reference ] && return 0
  check_main
  if has_base "$name"; then
    withbase=1
    conf=$(base_conf "$name")
    [ -f "$(base_dir "$name")/settings.json" ] \
      || { echo "base absente pour $name : claude-profile base $name update" >&2; return 2; }
  fi
  mkdir -p "$dir"
  repair_credentials "$dir"
  for e in "$base"/* "$base"/.[!.]*; do
    [ -e "$e" ] || [ -L "$e" ] || continue
    n=${e##*/}
    [ "$n" = settings.json ] && continue
    [ -n "$withbase" ] && [[ " $own_config " == *" $n "* ]] && { [ -L "$dir/$n" ] && rm -f "$dir/$n"; continue; }
    link_entry "$e" "$dir/$n"
  done
  # Avec base : sa config (celle que ~/.claude ne donne pas, et ce qu'elle seule a).
  if [ -n "$withbase" ]; then
    for e in "$conf"/* "$conf"/.[!.]*; do
      [ -e "$e" ] || continue
      n=${e##*/}
      case "$n" in settings.json|settings.json.*) continue ;; esac
      [[ " $own_config " == *" $n "* ]] || [ ! -e "$base/$n" ] || continue
      link_entry "$e" "$dir/$n"
    done
  fi
  rm -f "$dir/.claude.json"
  ln -s "$HOME/.claude.json" "$dir/.claude.json"
  find "$dir" -maxdepth 1 -xtype l -delete
  tmp=$(mktemp "$dir/.settings.XXXXXX")
  merged "$name" > "$tmp" \
    && chmod 644 "$tmp" && mv "$tmp" "$dir/settings.json" || { rm -f "$tmp"; die "lecture impossible : $profiles_dir/$name.json"; }
  [ -n "$withbase" ] && base_warnings "$name"
  jq -e '.enabledPlugins["profiles@claude-tools"] == true' "$dir/settings.json" >/dev/null \
    || echo "attention : $name n'active pas profiles@claude-tools, /profile n'y sera pas disponible" >&2
}

# Lance claude, puis tant qu'une demande de bascule a été déposée (claude-profile request, depuis
# /profile), relance la session demandée dans le profil demandé. $1 : profil à lancer, vide
# pour garder l'environnement tel quel (claude-profile run dans une session de profil).
launch_loop() {
  local name=$1 req rc id dir
  shift
  req=${XDG_RUNTIME_DIR:-/tmp}/claude-profile-switch.$$
  export CLAUDE_PROFILE_SWITCH_FILE=$req
  rm -f "$req"
  while :; do
    case "$name" in
      "")      claude "$@" ;;
      # Le script relu, pas la fonction en mémoire : une boucle lancée avant une mise à jour du
      # dépôt générerait sinon avec l'ancien code.
      *)       "$(readlink -f "${BASH_SOURCE[0]}")" generate "$name" >/dev/null || return 2
               dir=$(config_dir "$name")
               if [ -z "$dir" ]; then env -u CLAUDE_CONFIG_DIR claude "$@"; else env CLAUDE_CONFIG_DIR="$dir" claude "$@"; fi ;;
    esac
    rc=$?
    [ -s "$req" ] || { rm -f "$req"; return "$rc"; }
    read -r name id < "$req"; rm -f "$req"
    echo "→ profil $name" >&2
    # Une session encore vide n'a pas de transcript : rien à reprendre, session neuve.
    if [ -n "$(find "$base/projects" -maxdepth 2 -name "$id.jsonl" -print -quit 2>/dev/null)" ]; then
      set -- --resume "$id"
    else
      set --
    fi
  done
}

# Dépose une demande de bascule pour la boucle qui a lancé cette session (--cancel : la retire).
# Code 3 : session lancée hors boucle (claude sans la fonction shell, IDE…), bascule manuelle.
# Code 4 : demande déposée, mais session d'arrière-plan (claude daemon, reconnue à
# CLAUDE_JOB_DIR, variable non documentée) : /exit la détache sans quitter le claude que la
# boucle attend ; la bascule se fait une fois la session arrêtée et ce claude quitté.
cmd_request() {
  if [ "${1:-}" = --cancel ]; then rm -f "${CLAUDE_PROFILE_SWITCH_FILE:-/dev/null/none}" 2>/dev/null; return 0; fi
  [ $# -eq 2 ] || die "usage : claude-profile request <nom> <session> | --cancel"
  check "$1"
  [ -n "${CLAUDE_PROFILE_SWITCH_FILE:-}" ] || { echo "session lancée hors de claude-profile switch/run : relance manuelle" >&2; exit 3; }
  printf '%s %s\n' "$1" "$2" > "$CLAUDE_PROFILE_SWITCH_FILE"
  if [ -n "${CLAUDE_JOB_DIR:-}" ]; then
    echo "Session d'arrière-plan : /exit la détache sans la quitter. Bascule vers $1 en attente :" \
      "/profile stop arrête cette session, puis quitter le claude de ce terminal (Ctrl+C) ;" \
      "la boucle relance alors la conversation dans $1. /profile cancel : annuler." >&2
    exit 4
  fi
}

# Commande lancée avec HOME = celui de la base de $1 (git y passe par gh pour les dépôts https de GitHub).
in_base() {
  local h
  h=$(base_dir "$1")/home
  shift
  if command -v gh >/dev/null 2>&1; then
    env HOME="$h" GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=credential.https://github.com.helper \
      GIT_CONFIG_VALUE_0='!gh auth git-credential' "$@"
  else
    env HOME="$h" "$@"
  fi
}

# HOME de la base : les outils de la machine liés depuis le vrai HOME.
prepare_base_home() {
  local n
  mkdir -p "$1/.config"
  for n in $shared_home_dirs; do mkdir -p "$HOME/$n" && link_entry "$HOME/$n" "$1/$n"; done
  for n in $shared_home_links; do [ -e "$HOME/$n" ] && link_entry "$HOME/$n" "$1/$n"; done
  return 0
}

# Installe dans la base les plugins activés du profil qui n'y sont pas, depuis la marketplace que
# ~/.claude connaît pour eux, puis remet les plugins de la base dans son settings.json (claude plugin
# install les y ajoute : ils ne sont pas de la base).
install_profile_plugins() {
  local name=$1 conf p m src
  conf=$(base_conf "$name")
  for p in $(jq -r '.enabledPlugins // {} | to_entries[] | select(.value) | .key' "$profiles_dir/$name.json"); do
    jq -e --arg p "$p" '.plugins[$p]' "$conf/plugins/installed_plugins.json" >/dev/null 2>&1 && continue
    m=${p#*@}
    if ! jq -e --arg m "$m" 'has($m)' "$conf/plugins/known_marketplaces.json" >/dev/null 2>&1; then
      src=$(jq -r --arg m "$m" '.[$m].source | .path // .repo // .url // empty' "$base/plugins/known_marketplaces.json" 2>/dev/null)
      [ -n "$src" ] || { echo "marketplace $m inconnue de ~/.claude : $p non installé" >&2; continue; }
      in_base "$name" claude plugin marketplace add "$src" >&2 || { echo "marketplace $m : ajout impossible" >&2; continue; }
    fi
    in_base "$name" claude plugin install "$p" >&2 || echo "installation impossible : $p" >&2
  done
  jq --slurpfile s "$(base_dir "$name")/settings.json" '.enabledPlugins = ($s[0].enabledPlugins // {})' "$conf/settings.json" \
    > "$conf/settings.json.tmp" && mv "$conf/settings.json.tmp" "$conf/settings.json"
}

# Base d'un profil : affichée, ou mise à jour (update) : clone ou git pull du dépôt, son installeur
# lancé avec le HOME de la base, settings.json qu'il produit retenu comme base, plugins du profil
# installés, ce qui a changé, puis profil régénéré.
cmd_base() {
  { [ $# -eq 1 ] || { [ $# -eq 2 ] && [ "$2" = update ]; }; } || die "usage : claude-profile base <nom> [update]"
  check "$1"
  has_base "$1" || die "profil sans base : $1"
  local name=$1 d f repo install old rc
  d=$(base_dir "$name")
  f=$profiles_dir/$name.json
  repo=$(jq -r '.base.repo' "$f")
  install=$(jq -r '.base.install // "install.sh"' "$f")
  if [ $# -eq 1 ]; then
    echo "base de $name : $repo ($install)"
    echo "dossier : ${d/#$HOME/\~}"
    if [ -d "$d/repo/.git" ]; then echo "version : $(git -C "$d/repo" log -1 --format='%h %s (%cr)')"
    else echo "version : pas encore installée (claude-profile base $name update)"; fi
    if [ -f "$d/settings.json" ]; then
      echo "mise à jour : $(date -r "$d/settings.json" '+%F %T')"
      echo "plugins de la base :"
      jq -r '.enabledPlugins // {} | to_entries[] | "  \(if .value then "+" else "-" end) \(.key)"' "$d/settings.json"
    fi
    return
  fi
  mkdir -p "$d"
  if [ -d "$d/repo/.git" ]; then
    git -C "$d/repo" pull -q --ff-only || die "git pull impossible : $d/repo"
  else
    git clone -q "$repo" "$d/repo" || die "clone impossible : $repo"
  fi
  prepare_base_home "$d/home"
  echo "installeur de la base : $install (HOME=${d/#$HOME/\~}/home)"
  (cd "$d/repo" && in_base "$name" bash "$install" < /dev/null)
  rc=$?
  jq -e 'type == "object"' "$d/home/.claude/settings.json" >/dev/null 2>&1 \
    || die "l'installeur n'a pas produit de settings.json lisible : $d/home/.claude/settings.json"
  old=$(cat "$d/settings.json" 2>/dev/null || echo null)
  cp "$d/home/.claude/settings.json" "$d/settings.json"
  install_profile_plugins "$name"
  jq -rn --argjson old "$old" --slurpfile new "$d/settings.json" '
    if $old == null then "base installée"
    else
      def on($s): $s.enabledPlugins // {} | with_entries(select(.value)) | keys;
      [(on($new[0]) - on($old) | .[] | "  + \(.)"), (on($old) - on($new[0]) | .[] | "  - \(.)"),
       ([($old + $new[0]) | keys[] | select(. != "enabledPlugins" and $old[.] != $new[0][.])]
        | select(length > 0) | "  réglages modifiés : \(join(", "))")]
      | if . == [] then "base inchangée" else "base modifiée :", .[] end
    end'
  generate "$name" && echo "généré : $name ($out_root/$name)"
  [ "$rc" -eq 0 ] || { echo "l'installeur a signalé des échecs (code $rc) : voir ci-dessus, puis claude-profile base $name update" >&2; return 1; }
}

cmd_list() {
  local cur def proj n state
  cur=$(current)
  def=$(default_profile)
  proj=$(project_profile 2>/dev/null)
  printf '%s %-16s %s [%s]\n' "$([ "$cur" = reference ] && echo '*' || echo ' ')" reference \
    "Profil de référence (~/.claude/settings.json)" \
    "référence$([ -z "$def" ] && echo ", par défaut")$([ "$proj" = reference ] && echo ", projet")"
  for n in $(names); do
    if [ -f "$out_root/$n/settings.json" ]; then state=généré; else state="non généré"; fi
    [ "$n" = "$def" ] && state="$state, par défaut"
    [ "$n" = "$proj" ] && state="$state, projet"
    printf '%s %-16s %s [%s]\n' "$([ "$cur" = "$n" ] && echo '*' || echo ' ')" "$n" \
      "$(jq -r '.description // ""' "$profiles_dir/$n.json" 2>/dev/null)" "$state"
  done
}

# Ce qui est actif sur un profil (celui de la session par défaut) : plugins activés ou non,
# y compris ceux installés que le profil ne mentionne pas, avec l'état du profil de référence quand il
# diffère, modèle.
cmd_show() {
  [ $# -le 1 ] || die "usage : claude-profile show [<nom>]"
  local name=${1:-$(current)} def f state installed settings pf based=false bp='{}' own='{}' snapon='[]' baseline=""
  check "$name"
  [ "$name" = reference ] || check_main
  def=$(default_profile)
  if [ "$name" = reference ]; then
    f=$main
    state="référence$([ -z "$def" ] && echo ", par défaut")"
  else
    f=$profiles_dir/$name.json
    if [ -f "$out_root/$name/settings.json" ]; then state=généré; else state="non généré"; fi
    [ "$name" = "$def" ] && state="$state, par défaut"
  fi
  if has_base "$name"; then
    [ -f "$(base_dir "$name")/settings.json" ] || die "base absente pour $name : claude-profile base $name update"
    based=true
    bp=$(base_plugins "$name")
    own=$(jq -c '.enabledPlugins // {}' "$f")
    snapon=$(jq -c '.enabledPlugins // {} | with_entries(select(.value)) | keys' "$(base_dir "$name")/settings.json")
    baseline="$(jq -r '.base.repo' "$f") ($(git -C "$(base_dir "$name")/repo" log -1 --format='%h, %cr' 2>/dev/null || echo 'version inconnue'))"
  fi
  settings=$(merged "$name") || die "lecture impossible : $f"
  pf=$(plugins_file "$name")
  installed=$(jq -c '.plugins // {} | keys' "$pf" 2>/dev/null || echo '[]')
  [ -f "$mcp_cache" ] || mcp_scan >/dev/null 2>&1
  jq -r --arg name "$name" --arg cur "$(current)" --arg state "$state" --arg file "${f/#$HOME/\~}" \
     --arg desc "$([ "$name" = reference ] || jq -r '.description // ""' "$f")" --argjson installed "$installed" \
     --argjson servers "$(mcp_servers "$settings" "$pf")" --argjson based "$based" --argjson bp "$bp" \
     --argjson own "$own" --argjson snapon "$snapon" --arg baseline "$baseline" \
     --slurpfile ref "$main" "$jq_mcp"'
    (.enabledPlugins // {}) as $on
    | ($ref[0].enabledPlugins // {}) as $main
    # Pas de comparaison au profil de référence pour lui-même, ni pour un profil avec base.
    | ($name == "reference" or $based) as $noref
    | def reference($k): if $noref or ($on[$k] // false) == ($main[$k] // false) then ""
        else " (référence : \(if $main[$k] then "activé" else "désactivé" end))" end;
    "profil : \($name)\(if $name == $cur then " (actuel)" else "" end) [\($state)]",
      (if $desc != "" then "  \($desc)" else empty end),
      "réglages : \($file)",
      (if $based then
        "base : \($baseline)",
        "plugins de la base :",
        ($bp | to_entries[] | "  \(if .value then "+" else "-" end) \(.key)\(if .value | not then " (coupé par le profil)"
          elif .key | IN($snapon[]) then "" else " (dépendance)" end)"),
        "plugins :",
        ($own | to_entries[] | "  \(if .value then "+" else "-" end) \(.key)\(if .value then "" else " (désactivé)" end)"),
        ($installed - ($bp | keys) - ($own | keys) | .[] | "  ? \(.) (installé, absent du profil : inactif)")
      else
        "plugins :",
        ($on | to_entries[] | "  \(if .value then "+" else "-" end) \(.key)\(if .value then "" else " (désactivé)" end)\(reference(.key))"),
        ($installed - ($on | keys) | .[] | "  ? \(.) (installé, absent du profil : inactif)\(reference(.))")
      end),
      "MCP :",
      ((.deniedMcpServers // []) as $d | ($ref[0].deniedMcpServers // []) as $rd
       | (.disableClaudeAiConnectors // false) as $all | ($ref[0].disableClaudeAiConnectors // false) as $rall
       | def off($s; $d; $all): denied($s; $d) or ($all and ($s.name | startswith("claude.ai ")));
         def refnote($s; $isoff): if $noref or $isoff == off($s; $rd; $rall) then ""
           else " (référence : \(if $isoff then "actif" else "coupé" end))" end;
         (if $all then "  - claude.ai (tous les connecteurs coupés)" else "  + claude.ai (tous les connecteurs)" end)
           + (if $noref or $all == $rall then "" else " (référence : \(if $rall then "coupés" else "actifs" end))" end),
         ($servers[] | off(.; $d; $all) as $isoff
           | "  \(if $isoff then "-" else "+" end) \(.name)\(if denied(.; $d) then " (coupé)" elif $isoff then " (coupé : tous les connecteurs)" else "" end)\(refnote(.; $isoff))"),
         ($d[] | . as $e | select(any($servers[]; ($e.serverName == .name) or urlmatch($e.serverUrl; .url)) | not)
           | "  - \(.serverName // .serverUrl // tojson) (coupé)")),
      "modèle : \(.model // "par défaut")",
      (if $noref then empty else
        [($on + $main) | keys[] | select(($on[.] // false) != ($main[.] // false))] as $diff
        | "plugins différents du profil de référence : \(if $diff == [] then "aucun" else $diff | join(", ") end)"
       end)
  ' <<< "$settings"
}

# Relève les serveurs MCP connus avec claude mcp list sur le profil de référence (~6 s : il les
# contacte tous), fusionnés au cache, qui garde ainsi un serveur que la référence coupe.
mcp_scan() {
  local out tmp
  command -v claude >/dev/null 2>&1 || die "claude absent : relevé des MCP impossible"
  out=$(env -u CLAUDE_CONFIG_DIR claude mcp list 2>/dev/null) || die "claude mcp list a échoué"
  mkdir -p "$out_root"
  tmp=$(mktemp "$out_root/.mcp-servers.XXXXXX")
  jq -Rn --argjson old "$(jq -c 'if type == "array" then . else [] end' "$mcp_cache" 2>/dev/null || echo '[]')" '
    [inputs | capture("^(?<name>.+?): (?<url>\\S+)(?: \\([A-Za-z]+\\))? - ")?
     | .url |= (if test("^https?://") then . else null end)] as $new
    | $old + $new | group_by(.name) | map(.[-1])' <<< "$out" > "$tmp" \
    && mv "$tmp" "$mcp_cache" || { rm -f "$tmp"; die "écriture impossible : $mcp_cache"; }
}

# Serveurs MCP connus pour un settings.json ($1) : le cache de mcp-scan, plus ceux des .mcp.json des
# plugins qu'il active (plugin:<plugin>:<serveur>), installés selon $2 (installed_plugins.json, celui de
# ~/.claude par défaut), en JSON [{name, url}].
mcp_servers() {
  local p dir extra='[]' pf=${2:-$base/plugins/installed_plugins.json}
  for p in $(jq -r '.enabledPlugins // {} | to_entries[] | select(.value) | .key' <<< "$1"); do
    dir=$(jq -r --arg p "$p" '.plugins[$p][0].installPath // empty' "$pf" 2>/dev/null)
    [ -f "$dir/.mcp.json" ] || continue
    extra=$(jq -c --argjson extra "$extra" --arg p "${p%@*}" \
      '$extra + [(.mcpServers // .) | to_entries[] | {name: "plugin:\($p):\(.key)", url: (.value.url // null)}]' "$dir/.mcp.json" 2>/dev/null || echo "$extra")
  done
  jq -c --argjson extra "$extra" 'if type == "array" then . else [] end | . + $extra | group_by(.name) | map(.[-1])' "$mcp_cache" 2>/dev/null \
    || echo "$extra"
}

cmd_new() {
  [ $# -ge 1 ] || die "usage : claude-profile new <nom> [description…]"
  local name=$1 f
  shift
  case "$name" in reference|default|project|show|create|stop|cancel|base) die "nom réservé : $name" ;; esac
  [[ $name =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "nom invalide : $name (minuscules, chiffres, tirets)"
  f=$profiles_dir/$name.json
  [ -e "$f" ] && die "existe déjà : $f"
  mkdir -p "$profiles_dir"
  if jq -e 'type == "object"' "$main" >/dev/null 2>&1; then
    jq --arg d "$*" '{description: $d, enabledPlugins: (.enabledPlugins // {"profiles@claude-tools": true})}' "$main" > "$f"
  else
    jq -n --arg d "$*" '{description: $d, enabledPlugins: {"profiles@claude-tools": true}}' > "$f"
  fi
  echo "créé : $f (plugins du profil de référence, à adapter ; le reste vient du profil de référence)"
}

# Active ou désactive un plugin dans un profil, puis le régénère ; dans le profil de référence, écrit à
# travers le lien ~/.claude/settings.json (vers le dépôt), que mv remplacerait.
cmd_plugin() {
  [ $# -eq 3 ] && [[ $3 =~ ^(on|off)$ ]] || die "usage : claude-profile plugin <nom> <plugin>@<marketplace> on|off"
  check "$1"
  local f tmp inbase=false
  if [ "$1" = reference ]; then f=$main; else f=$profiles_dir/$1.json; fi
  # Profil avec base : un plugin de la base se coupe par base.disabledPlugins, les autres sont ceux du profil.
  if has_base "$1"; then
    [ -f "$(base_dir "$1")/settings.json" ] || die "base absente pour $1 : claude-profile base $1 update"
    inbase=$(jq --arg p "$2" 'has($p)' <<< "$(base_plugins "$1")")
  fi
  tmp=$(mktemp "$profiles_dir/.plugin.XXXXXX" 2>/dev/null || mktemp)
  jq --arg p "$2" --argjson on "$([ "$3" = on ] && echo true || echo false)" --argjson inbase "$inbase" '
    if $inbase then
      .base.disabledPlugins = ((.base.disabledPlugins // []) - [$p] + (if $on then [] else [$p] end))
      | if .enabledPlugins | has($p) then del(.enabledPlugins[$p]) else . end
    else .enabledPlugins[$p] = $on end' "$f" > "$tmp" \
    && cat "$tmp" > "$f" && rm -f "$tmp" || { rm -f "$tmp"; die "écriture impossible : $f"; }
  [ "$2" = profiles@claude-tools ] && [ "$3" = off ] \
    && echo "attention : sans profiles@claude-tools, /profile ne sera pas disponible dans $1" >&2
  [ "$inbase" = false ] && [ "$3" = on ] && has_base "$1" && install_profile_plugins "$1"
  generate "$1"
  echo "$2 : $([ "$3" = on ] && echo activé || echo désactivé) dans $1"
}

# Coupe (off) ou réactive (on) un serveur MCP dans un profil, puis le régénère : entrée serverName
# (ou serverUrl pour une url) de deniedMcpServers ; claude.ai : disableClaudeAiConnectors. Un profil
# qui n'a pas encore sa liste part de celle de la référence (section remplacée en entier).
cmd_mcp() {
  [ $# -eq 3 ] && [[ $3 =~ ^(on|off)$ ]] || die "usage : claude-profile mcp <nom> <serveur|url|claude.ai> on|off"
  check "$1"
  local f tmp url
  if [ "$1" = reference ]; then f=$main; else f=$profiles_dir/$1.json; fi
  url=$(jq -r --arg n "$2" 'map(select(.name == $n))[0].url // ""' "$mcp_cache" 2>/dev/null)
  tmp=$(mktemp "$profiles_dir/.mcp.XXXXXX" 2>/dev/null || mktemp)
  jq --arg s "$2" --arg url "$url" --arg state "$3" --argjson isref "$([ "$1" = reference ] && echo true || echo false)" \
     --slurpfile ref "$main" "$jq_mcp"'
    $ref[0] as $r
    | if $s == "claude.ai" then
        if $state == "off" then .disableClaudeAiConnectors = true
        elif $isref or ($r.disableClaudeAiConnectors // false) == false then del(.disableClaudeAiConnectors)
        else .disableClaudeAiConnectors = false end
      else
        (if $isref then .deniedMcpServers // [] else .deniedMcpServers // $r.deniedMcpServers // [] end) as $d
        | (if ($s | test("^https?://")) then {serverUrl: $s} else {serverName: $s} end) as $e
        | (if $state == "off" then (if any($d[]; . == $e) then $d else $d + [$e] end)
           else $d | map(select(. != $e and (urlmatch(.serverUrl; if $url == "" then null else $url end) | not))) end) as $new
        | if $new == [] and ($isref or ($r.deniedMcpServers // []) == []) then del(.deniedMcpServers) else .deniedMcpServers = $new end
      end' "$f" > "$tmp" \
    && cat "$tmp" > "$f" && rm -f "$tmp" || { rm -f "$tmp"; die "écriture impossible : $f"; }
  generate "$1"
  echo "$2 : $([ "$3" = on ] && echo réactivé || echo coupé) dans $1 (à la prochaine session)"
}

# Profil par défaut, celui des nouvelles sessions de claude-profile run (fonction shell claude,
# cl) : nommé dans ~/.claude-profiles/.default ; sans lui, elles partent sur le profil de référence.
cmd_default() {
  [ $# -le 1 ] || die "usage : claude-profile default [<nom>|--unset]"
  if [ $# -eq 0 ]; then default_profile | grep . || echo reference; return; fi
  case "$1" in
    reference|--unset)
      rm -f "$default_file"
      echo "profil par défaut : reference (aucun profil par défaut)" ;;
    *)
      check "$1"
      generate "$1" || exit 2
      mkdir -p "$out_root" && echo "$1" > "$default_file" || die "écriture impossible : $default_file"
      echo "profil par défaut : $1 (nouvelles sessions lancées par claude-profile run : fonction shell claude, cl)" ;;
  esac
}

# Profil du projet courant, celui des nouvelles sessions de claude-profile run lancées dans ce projet
# (avant le profil par défaut) : nommé dans .claude/profile.local à la racine du projet (dépôt git,
# sinon dossier courant), ignoré par git grâce au .claude/.gitignore généré à côté. --unset retire ce
# fichier (et ce .gitignore s'il n'a que ce qui a été généré).
cmd_project() {
  [ $# -le 1 ] || die "usage : claude-profile project [<nom>|--unset]"
  local f p root ignore
  if [ $# -eq 0 ]; then
    f=$(project_file)
    p=$(project_profile)
    if [ -n "$p" ]; then echo "$p (${f/#$HOME/\~})"; else echo "aucun profil de projet (nouvelles sessions : $(default_profile | grep . || echo reference))"; fi
    return
  fi
  root=$(project_root)
  [ "$root" != "$HOME" ] || die "pas de profil de projet pour \$HOME : se placer dans un projet"
  f=$root/$project_rel
  ignore=$root/.claude/.gitignore
  if [ "$1" = --unset ]; then
    rm -f "$f"
    [ "$(cat "$ignore" 2>/dev/null)" = "$project_ignore" ] && rm -f "$ignore"
    rmdir "$root/.claude" 2>/dev/null
    echo "profil du projet retiré : ${root/#$HOME/\~} (nouvelles sessions : $(default_profile | grep . || echo reference))"
    return
  fi
  check "$1"
  generate "$1" || exit 2
  mkdir -p "$root/.claude" && echo "$1" > "$f" || die "écriture impossible : $f"
  # Non versionné : .claude/.gitignore généré, qui s'ignore lui-même ; s'il existe déjà (celui du
  # projet), seulement complété.
  if [ ! -e "$ignore" ]; then
    echo "$project_ignore" > "$ignore"
  elif ! grep -qxF -e "${project_rel#.claude/}" -e "/${project_rel#.claude/}" "$ignore"; then
    echo "${project_rel#.claude/}" >> "$ignore" && echo "ajouté à ${ignore/#$HOME/\~} : ${project_rel#.claude/}"
  fi
  echo "profil du projet : $1 (${f/#$HOME/\~} ; nouvelles sessions lancées ici par claude-profile run : fonction shell claude, cl)"
}

command -v jq >/dev/null 2>&1 || die "jq requis"

case "${1:-}" in
  list|"")  cmd_list ;;
  current)  current ;;
  default)  shift; cmd_default "$@" ;;
  project)  shift; cmd_project "$@" ;;
  show)     shift; cmd_show "$@" ;;
  new)      shift; cmd_new "$@" ;;
  plugin)   shift; cmd_plugin "$@" ;;
  mcp)      shift; cmd_mcp "$@" ;;
  base)     shift; cmd_base "$@" ;;
  mcp-scan) mcp_scan && jq -r '.[] | "\(.name)\(if .url then "  \(.url)" else "" end)"' "$mcp_cache" ;;
  check)    [ $# -eq 2 ] || die "usage : claude-profile check <nom>"; check "$2" ;;
  request)  shift; cmd_request "$@" ;;
  remember) shift; cmd_remember "$@" ;;
  background) [ -n "${CLAUDE_JOB_DIR:-}" ] ;;
  run)      shift
            # Hors session de profil : une reprise part sur le dernier profil de la conversation,
            # une nouvelle session sur le profil du projet, sinon le profil par défaut.
            name=""
            if [ -z "${CLAUDE_CONFIG_DIR:-}" ]; then
              id=$(resumed_session "$@")
              [ -n "$id" ] && name=$(session_profile "$id")
              if [ -n "$name" ]; then echo "→ profil $name (dernier de cette conversation)" >&2
              else
                name=$(project_profile)
                if [ -n "$name" ]; then echo "→ profil $name (projet)" >&2; else name=$(default_profile); fi
              fi
            fi
            launch_loop "$name" "$@" ;;
  generate)
    [ $# -eq 2 ] || die "usage : claude-profile generate <nom>|--all"
    if [ "$2" = --all ]; then
      for n in $(names); do generate "$n" && echo "généré : $n"; done
    else
      generate "$2" && echo "généré : $2 ($out_root/$2)"
    fi ;;
  switch)
    [ $# -ge 2 ] || die "usage : claude-profile switch <nom> [arguments claude…]"
    name=$2; shift 2
    check "$name"
    launch_loop "$name" "$@" ;;
  --help|-h) usage ;;
  *) echo "commande inconnue : $1" >&2; usage >&2; exit 2 ;;
esac
