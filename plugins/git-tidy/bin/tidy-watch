#!/usr/bin/env python3
"""tidy-watch — lance /git-tidy:ready quand une de mes PR a ses approbations.

Un événement, interrogé par `poll` (timer systemd utilisateur, toutes les 5 min par défaut :
`interval` de la config) :
  pr_approved  une de mes PR ouvertes est à l'état « approved » de gh-watch board (même
               calcul) : hors brouillon, au moins `approvals` approbations (2 par défaut ;
               dernier avis de chaque relecteur autre que moi), aucun changement demandé,
               aucun fil ni message de review en attente de moi → /git-tidy:ready <n>

Mode par dépôt, clé on_pr_approved (section `watcher` de ~/.config/claude-tools/git-tidy.json,
`watcher.repos` : le dépôt l'emporte sur son propriétaire, owner/*, qui l'emporte sur * ; rien
de réglé : off). Approbations attendues et réglages de /git-tidy:ready : hors de `watcher`,
dans le même fichier, lus aussi par les skills de git-tidy.
  auto     la session est lancée : herdr (worktree + pane) s'il tourne, sinon analyse en
           fond (claude -p … --prepare) puis notification, dont le clic reprend la session
           dans un terminal pour la validation
  notify   notification seulement ; son clic lance la session comme en auto
  off      rien (défaut)
Rien n'est réécrit, poussé ni publié sans validation dans la session.
Mécanique commune avec review-watch : lib/watchlib.py du plugin gh-watch.

  tidy-watch status                          surveillance, dépôts, sessions
  tidy-watch repos [--json]                  dépôts configurés et clones GitHub trouvés
  tidy-watch auto <owner/repo|owner/*|*|.> on|off
                                             (owner/* : tous les dépôts du propriétaire,
                                             * : tous les dépôts ; off : retour au
                                             niveau au-dessus — dépôt → owner/* → * → off)
  tidy-watch add <owner/repo|owner/*|*|.> [--on-pr-approved M] [--path <clone> | --path <dossier>/*]
                                             (sans mode ni --path : auto ; dossier/* : où
                                             chercher les clones, avant les espaces de cl)
  tidy-watch remove <owner/repo|owner/*|*|.>
  tidy-watch approvals <owner/repo|*|.> [<n> | default]  approbations attendues (* : 2 par défaut)
  tidy-watch set <owner/repo|*|.> validation_status|test_env [<valeur> | default]
                                             réglages de /git-tidy:ready (sans valeur : affiche)
  tidy-watch enable | disable                timer systemd (enable : état initial d'abord)
  tidy-watch interval [<minutes>]            fréquence du scan (5 par défaut), appliquée au timer
  tidy-watch poll [--dry-run]                un passage
  tidy-watch launch <owner/repo#n | n> [pr_approved] [--at <date>] [--background]
                                             (--at : date de l'événement, alors retenu
                                             comme traité ; --background : analyse en fond
                                             même si herdr tourne)
  tidy-watch skip <owner/repo#n | n> pr_approved --at <date>
                                             écarter cet événement (gh-watch skip)
  tidy-watch resume [<owner/repo#n>]         session préparée en fond
"""
import os, sys

# watchlib : plugin gh-watch (dépendance), à côté dans le même clone
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__)))),
                                "gh-watch", "lib"))
import watchlib as w  # noqa: E402
import board as b  # noqa: E402

APPROVALS = 2
SETTINGS = {"validation_status": "En validation", "test_env": None}  # réglages de /git-tidy:ready


def settings_path():
    """git-tidy.json : approbations et réglages de /git-tidy:ready, lus aussi par les skills
    ({"default": {…}, "repos": {…}}, hors de la section `watcher`)."""
    return w.S.config


def settings():
    return w.load_json(settings_path())


def approvals(cfg, repo):
    """cfg : config du watcher, non utilisée (approbations dans git-tidy.json)."""
    return int(w.setting(settings(), repo, "approvals", APPROVALS))


def approved_events(cfg, state, delay):
    """Mes PR à l'état « approved » de gh-watch board (board.watched : même calcul que le
    tableau) — hors brouillon, au moins `approvals` approbations d'autres que moi (dernier
    avis de chacun, robots exclus), aucun changement demandé, aucun retour en attente de
    moi : ([(repo, n, titre, url, date de la N-ième approbation)], [PR approuvées mais
    dont des retours attendent ma réponse : (repo, n, titre, raison)]). Cette date ne bouge
    pas avec une approbation de plus ni avec un push : seule une nouvelle série
    d'approbations (après qu'elles ont été écartées) relance. Une review trop récente
    (< delay s) attend le passage suivant."""
    login, prs = b.watched(lambda repo: approvals(cfg, repo))
    state["me"] = login
    events, waiting = [], []
    for pr, c in prs:
        repo, n = pr["repository"]["nameWithOwner"], pr["number"]
        if c["state"] == "feedback" and not c["changes"] and c["approvals"] >= approvals(cfg, repo):
            why = [f"{c['threads_on_me']} fil(s) de review"] if c["threads_on_me"] else []
            why += [f"{c['messages']} message(s) de review"] if c["messages"] else []
            waiting.append((repo, n, pr["title"], " et ".join(why)))
            continue
        at = c["event_at"]
        if c["state"] != "approved" or state["pr_approved"].get(f"{repo}#{n}", "") >= at:
            continue
        if (w.now() - w.parse(c["latest_at"] or at)).total_seconds() < delay:
            continue
        events.append((repo, n, pr["title"], pr["url"], at))
    return events, waiting


def events(cfg, state, since, delay, dry_run=False, seed=False):
    found, waiting = approved_events(cfg, state, delay)
    out = []
    for repo, n, title, why in waiting:
        out.append(f"{repo}#{n} (pr_approved) : {why} en attente de réponse, attend le passage suivant")
        if not dry_run and not seed and w.mode(cfg, repo, "pr_approved") != "off":
            w.record(state, "pr_approved", repo, n, "en attente", f"{why} en attente de ta réponse", title)
    return [("pr_approved", *e) for e in found], out


def repo_extra(cfg, repo):
    return f" (approvals={approvals(cfg, repo)})"


def extra(cfg, repo):
    st = settings()
    return {"approvals": approvals(cfg, repo),
            **{k: w.setting(st, repo, k, d) for k, d in SETTINGS.items()}}


def entry(st, repo):
    """Réglages de git-tidy.json à modifier : `default` pour « * » (format lu par les skills),
    sinon l'entrée du dépôt."""
    return st.setdefault("default", {}) if repo == "*" else st.setdefault("repos", {}).setdefault(repo, {})


def drop(st, repo, key):
    e = entry(st, repo)
    e.pop(key, None)
    if not e:
        (st if repo == "*" else st["repos"]).pop("default" if repo == "*" else repo, None)


def extend(sub):
    ap = sub.add_parser("approvals")
    ap.add_argument("repo")
    ap.add_argument("n", nargs="?")
    st = sub.add_parser("set")
    st.add_argument("repo")
    st.add_argument("key", choices=tuple(SETTINGS))
    st.add_argument("value", nargs="?")


def handle(cfg, args):
    if args.cmd == "approvals":
        repo = w.target_arg(args.repo)
        if args.n is not None:
            st = settings()
            if args.n == "default":
                drop(st, repo, "approvals")
            elif not args.n.isdigit() or int(args.n) < 1:
                w.die("nombre d'approbations attendu (1 au moins), ou default")
            else:
                entry(st, repo)["approvals"] = int(args.n)
            w.save_json(settings_path(), st)
        print(f"{repo} : {approvals(cfg, repo)} approbation(s) avant /git-tidy:ready"
              f" (on_pr_approved={w.mode(cfg, repo, 'pr_approved')})")
        return True
    if args.cmd == "set":
        repo = w.target_arg(args.repo)
        st = settings()
        if args.value is not None:
            if args.value == "default":
                drop(st, repo, args.key)
            else:
                entry(st, repo)[args.key] = args.value
            w.save_json(settings_path(), st)
        own = None if repo == "*" else w.repo_cfg(st, repo).get(args.key)
        dflt = st.get("default", {}).get(args.key)
        value = own if own is not None else dflt if dflt is not None else SETTINGS[args.key]
        source = "dépôt" if own is not None else "default" if dflt is not None else "défaut"
        print(f"{repo} : {args.key} = {value if value is not None else '(non réglé)'} ({source})")
        return True
    return False


w.configure(
    name="tidy-watch", env="TIDY_WATCH", self_path=__file__, config="git-tidy.json",
    legacy={"config": "git-tidy.json", "kinds": {"approved": "pr_approved"}},
    worktrees="tidy-worktrees",
    kinds=("pr_approved",),
    skill={"pr_approved": "git-tidy:ready"},
    label={"pr_approved": "préparation au merge"},
    tab={"pr_approved": "merge"},
    announce={"pr_approved": "PR approuvée, prête pour le merge"},
    # Message à une session déjà ouverte sur la PR : elle ne voit pas seule ce qui arrive ensuite
    tell={"pr_approved": "tidy-watch : nouvelle activité sur la PR #{n}{when} (approbations). "
                      "Revérifie l'état de la PR avant de continuer."},
    guess_kind=lambda state, repo, n: "pr_approved",
    repo_extra=repo_extra, extra=extra,
    # États du tableau de gh-watch board : pris en charge, ou seulement proposés
    board={"approved": "pr_approved"}, suggest={"behind": "git-tidy:pr-sync"},
)

if __name__ == "__main__":
    w.main(__doc__, events, extend, handle)
