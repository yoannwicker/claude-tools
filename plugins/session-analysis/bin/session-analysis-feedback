#!/usr/bin/env python3
"""session-analysis-feedback — journal des retours sur l'usage de Claude (skills, plugins,
hooks, consignes, MCP, sessions) : constats de Claude avec l'avis de l'utilisateur, et
retours de l'utilisateur.

  session-analysis-feedback add --source claude|utilisateur [--angle A]
                                --target-type T --target NOM --verdict V --text TEXTE
                                [--user-opinion O] [--comment TEXTE]
                                [--session ID] [--project P]
      Ajoute un retour au journal. Constat de Claude (--source claude) : --angle et
      --user-opinion obligatoires. Projet par défaut : celui de la session dans AgentsView,
      sinon le nom du dépôt git courant (tirets remplacés par _ : claude_tools).
  session-analysis-feedback list [--days N] [--project P] [--target NOM] [--session ID]
                                 [--source S] [--json]
      Relit le journal, du plus ancien au plus récent.

Journal (une ligne JSON par retour) : la clé « feedback » du premier .session-analysis.json
trouvé — à la racine du dépôt git courant (le principal, même depuis un worktree), puis
dans ~ — chemin relatif au dossier de ce fichier ; sinon
~/.local/share/session-analysis/feedback.jsonl.
"""
import argparse, datetime, json, os, subprocess, sys

TARGET_TYPES = ["skill", "plugin", "hook", "consigne", "mcp", "session", "autre"]
VERDICTS = ["positif", "négatif", "suggestion"]
SOURCES = ["claude", "utilisateur"]
ANGLES = ["déclenchement", "résultat", "friction", "consignes", "outillage", "manques"]
OPINIONS = ["d'accord", "nuancé", "pas d'accord"]


CONFIG = ".session-analysis.json"


def repo_root():
    """Dépôt principal, même depuis un worktree ; None hors d'un dépôt git."""
    out = subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
                         capture_output=True, text=True)
    return os.path.dirname(out.stdout.strip()) if out.returncode == 0 else None


def journal():
    for d in filter(None, [repo_root(), os.path.expanduser("~")]):
        conf = os.path.join(d, CONFIG)
        if not os.path.isfile(conf):
            continue
        try:
            path = json.load(open(conf)).get("feedback")
        except ValueError as e:
            sys.exit(f"session-analysis-feedback: {conf} illisible : {e}")
        if path:
            return os.path.join(d, os.path.expanduser(path))
    return os.path.expanduser("~/.local/share/session-analysis/feedback.jsonl")


def read_all(path=None):
    try:
        with open(path or journal()) as f:
            return [json.loads(line) for line in f if line.strip()]
    except FileNotFoundError:
        return []


def select(entries, days=None, project=None, target=None, session=None, date_from=None,
           source=None):
    if days is not None:
        date_from = (datetime.date.today() - datetime.timedelta(days=days)).isoformat()
    return [e for e in entries
            if (not date_from or e["date"][:10] >= date_from)
            and (not project or e.get("project") == project)
            and (not target or e.get("target") == target)
            and (not session or e.get("session") == session)
            and (not source or e.get("source") == source)]


def summary(entries):
    """Bloc « feedback » d'indicators.json : comptes par source, par avis, par angle, par type
    de cible, accord de l'utilisateur avec les constats de Claude, cibles les plus citées."""
    count = lambda key, es=entries: {k: sum(1 for e in es if e.get(key) == k)
                                     for k in sorted({e.get(key) for e in es} - {None})}
    targets = {}
    for e in entries:
        t = targets.setdefault(f"{e['target_type']}:{e['target']}", dict.fromkeys(VERDICTS, 0))
        t[e["verdict"]] += 1
    top = sorted(targets.items(), key=lambda x: -sum(x[1].values()))[:10]
    return {"retours": len(entries), "par_source": count("source"),
            "par_avis": count("verdict"), "par_angle": count("angle"),
            "par_type": count("target_type"),
            "accord_constats_claude": count("user_opinion",
                                            [e for e in entries if e.get("source") == "claude"]),
            "cibles": dict(top)}


def project_of(session):
    if session:
        try:
            out = subprocess.run(["agentsview", "session", "get", session, "--json"],
                                 capture_output=True, text=True, timeout=30)
            if out.returncode == 0 and json.loads(out.stdout).get("project"):
                return json.loads(out.stdout)["project"]
        except (OSError, ValueError, subprocess.TimeoutExpired):
            pass
    return os.path.basename(repo_root() or os.getcwd()).replace("-", "_")


def cmd_add(a):
    session = None if not a.session or a.session.startswith("${") else a.session
    entry = {"date": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
             "session": session, "project": a.project or project_of(session),
             "source": a.source, "angle": a.angle,
             "target_type": a.target_type, "target": a.target, "verdict": a.verdict,
             "text": a.text.strip(), "user_opinion": a.user_opinion,
             "comment": (a.comment or "").strip() or None}
    path = journal()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a") as f:
        f.write(json.dumps(entry, ensure_ascii=False) + "\n")
    print(f"noté dans {path} : {line(entry)}")


def line(e):
    opinion = f" — avis : {e['user_opinion']}" if e.get("user_opinion") else ""
    comment = f" ({e['comment']})" if e.get("comment") else ""
    angle = f"/{e['angle']}" if e.get("angle") else ""
    return (f"{e.get('project') or '-'}  {e.get('source', 'utilisateur')}{angle} [{e['verdict']}] "
            f"{e['target_type']}:{e['target']} — {e['text']}{opinion}{comment}")


def cmd_list(a):
    entries = select(read_all(), a.days, a.project, a.target, a.session, source=a.source)
    if a.json:
        print(json.dumps(entries, ensure_ascii=False, indent=1))
        return
    if not entries:
        print(f"aucun retour ({journal()})")
    for e in entries:
        print(f"{e['date'][:16].replace('T', ' ')}  {line(e)}")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    ad = sub.add_parser("add")
    ad.add_argument("--source", required=True, choices=SOURCES)
    ad.add_argument("--angle", choices=ANGLES)
    ad.add_argument("--target-type", required=True, choices=TARGET_TYPES)
    ad.add_argument("--target", required=True)
    ad.add_argument("--verdict", required=True, choices=VERDICTS)
    ad.add_argument("--text", required=True)
    ad.add_argument("--user-opinion", choices=OPINIONS)
    ad.add_argument("--comment")
    ad.add_argument("--session")
    ad.add_argument("--project")
    ls = sub.add_parser("list")
    ls.add_argument("--days", type=int)
    ls.add_argument("--project")
    ls.add_argument("--target")
    ls.add_argument("--session")
    ls.add_argument("--source", choices=SOURCES)
    ls.add_argument("--json", action="store_true")
    a = ap.parse_args()
    if a.cmd == "add":
        if not a.text.strip():
            ap.error("--text vide")
        if a.source == "claude" and not (a.angle and a.user_opinion):
            ap.error("constat de Claude : --angle et --user-opinion obligatoires")
        if a.source == "utilisateur" and a.user_opinion:
            ap.error("--user-opinion : seulement pour un constat de Claude")
    {"add": cmd_add, "list": cmd_list}[a.cmd](a)


if __name__ == "__main__":
    main()
