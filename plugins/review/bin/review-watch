#!/usr/bin/env python3
"""review-watch — lance /review:pr ou /review:feedback quand GitHub le demande.

Deux événements, interrogés par `poll` (timer systemd utilisateur, toutes les 5 min par
défaut : `interval` de la config) :
  review    une revue m'est demandée sur la PR d'un autre (notification `review_requested`,
            date de la demande lue dans la timeline de la PR) → /review:pr <n>
  feedback  une de mes PR ouvertes a des retours à traiter — état « feedback » de gh-watch
            board : changements demandés, fil non résolu dont le dernier message n'est pas
            de moi, ou message de review qui demande une réponse — depuis la dernière
            review traitée → /review:feedback <n>. Une review qui n'en laisse pas
            (approbation sans message, « LGTM ») : simple notification.

Mode par dépôt et par événement (config ~/.config/claude-tools/review-watch.json) :
  auto     la session est lancée : herdr (worktree + pane) s'il tourne, sinon analyse en
           fond (claude -p … --prepare) puis notification, dont le clic reprend la session
           dans un terminal pour la validation
  notify   notification seulement ; son clic lance la session comme en auto
  off      rien
Session herdr déjà ouverte sur la PR : message dans son pane (herdr agent prompt), sauf si
Claude y attend une réponse (notification critique à la place).
Dans tous les cas, rien n'est posté sur GitHub sans validation dans la session.
Mécanique commune (lancement, notifications, timer) : lib/watchlib.py du plugin gh-watch.

  review-watch status                          surveillance, dépôts, sessions
  review-watch repos [--json]                  dépôts configurés et clones GitHub trouvés
  review-watch auto <owner/repo|.> on|off [review|feedback]
                                               (off : retour au mode des dépôts non listés)
  review-watch add <owner/repo|.> [--review M] [--feedback M] [--path <clone>]
                                               (sans --review/--feedback : auto pour les deux)
  review-watch remove <owner/repo|.>
  review-watch default [--review M] [--feedback M]   mode des dépôts non listés (notify)
  review-watch enable | disable                timer systemd (enable : état initial d'abord)
  review-watch interval [<minutes>]            fréquence du scan (5 par défaut), appliquée au timer
                                               (sans argument : affiche et applique la config)
  review-watch poll [--dry-run]                un passage
  review-watch launch <owner/repo#n | n> [review|feedback] [--at <date>] [--background]
                                               (--at : date de l'événement, alors retenu
                                               comme traité ; gh-watch launch la donne ;
                                               --background : analyse en fond même si
                                               herdr tourne)
  review-watch skip <owner/repo#n | n> review|feedback --at <date>
                                               écarter cet événement (gh-watch skip)
  review-watch resume [<owner/repo#n> [review|feedback]]   session préparée en fond
"""
import json, os, sys

# watchlib : plugin gh-watch (dépendance), à côté dans le même clone
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__)))),
                                "gh-watch", "lib"))
import watchlib as w  # noqa: E402
import board as b  # noqa: E402

PR_QUERY = """query($o: String!, $r: String!, $n: Int!, $me: String!) {
  repository(owner: $o, name: $r) { pullRequest(number: $n) {
    number title url state isDraft author { login } headRefName headRefOid
    timelineItems(itemTypes: [REVIEW_REQUESTED_EVENT], last: 20) { nodes {
      ... on ReviewRequestedEvent { createdAt requestedReviewer {
        __typename ... on User { login } ... on Team { slug } } } } }
    reviews(last: 20, author: $me) { nodes { state submittedAt } } } } }"""


def pr_info(repo, n, login):
    o, r = repo.split("/")
    return w.graphql(PR_QUERY, o=o, r=r, n=int(n), me=login)["repository"]["pullRequest"]


def review_events(state, since):
    """PR des autres où une revue m'a été demandée (et pas encore faite) depuis le dernier
    passage traité : [(repo, n, titre, url, date de la demande)]."""
    login = w.me(state)
    notifs = w.gh_json(f"notifications?all=true&participating=true&per_page=50&since={w.iso(since)}") or []
    seen, events = set(), []
    for nt in notifs:
        if nt.get("reason") != "review_requested" or nt["subject"].get("type") != "PullRequest":
            continue
        repo = nt["repository"]["full_name"]
        n = int(nt["subject"]["url"].rsplit("/", 1)[1])
        if (repo, n) in seen:
            continue
        seen.add((repo, n))
        pr = pr_info(repo, n, login)
        if pr["state"] != "OPEN" or (pr.get("author") or {}).get("login") == login:
            continue
        asked = [e["createdAt"] for e in pr["timelineItems"]["nodes"]
                 if e and ((e.get("requestedReviewer") or {}).get("login") == login
                           or (e.get("requestedReviewer") or {}).get("__typename") == "Team")]
        asked_at = max(asked) if asked else nt["updated_at"]
        mine = [r["submittedAt"] for r in pr["reviews"]["nodes"] if r.get("submittedAt")]
        if mine and max(mine) >= asked_at:
            continue  # déjà relue depuis la demande
        if state["review"].get(f"{repo}#{n}", "") >= asked_at:
            continue
        events.append((repo, n, pr["title"], pr["url"], asked_at))
    return events


def feedback_events(state, delay):
    """Mes PR ouvertes avec une review d'un autre depuis la dernière traitée, classées par
    gh-watch board (board.watched : même calcul que le tableau) : [(repo, n, titre, url,
    date de la dernière review, à traiter ?, état de cette review)] — à traiter : état
    « feedback » avec des retours arrivés depuis la dernière review traitée ; un brouillon
    attend d'être prêt. Une review
    trop récente (< delay s) attend le passage suivant : le relecteur n'a peut-être pas fini."""
    login, prs = b.watched(lambda repo: 1)  # le seuil d'approbations ne change pas « feedback »
    state["me"] = login
    events = []
    for pr, c in prs:
        repo, n, latest = pr["repository"]["nameWithOwner"], pr["number"], c.get("latest_at")
        if c["state"] == "draft":
            continue  # brouillon : ses retours attendent qu'elle soit prête (la date n'est pas retenue)
        last = state["feedback"].get(f"{repo}#{n}", "")
        if not latest or latest <= last:
            continue
        if (w.now() - w.parse(latest)).total_seconds() < delay:
            continue
        # À traiter : des retours arrivés depuis la dernière review traitée (pas seulement
        # une approbation de plus sur des retours déjà vus)
        new = c["state"] == "feedback" and (c.get("feedback_at") or latest) > last
        events.append((repo, n, pr["title"], pr["url"], latest, new, c["latest_review"]))
    return events


def events(cfg, state, since, delay, dry_run=False, seed=False):
    todo = [("review", repo, n, title, url, at)
            for repo, n, title, url, at in review_events(state, since - w.dt.timedelta(minutes=2))]
    out = []
    for repo, n, title, url, at, actionable, review in feedback_events(state, delay):
        if actionable or seed or w.mode(cfg, repo, "feedback") == "off":
            todo.append(("feedback", repo, n, title, url, at))
            continue
        # Review sans retour à traiter (approbation, « LGTM ») : pas de session, une notification
        what = "approuvée" if review == "APPROVED" else "review"
        out.append(f"{repo}#{n} (feedback, {w.mode(cfg, repo, 'feedback')}) : {what} sans retour à traiter")
        if not dry_run:
            w.notify(f"PR approuvée : {repo}#{n}" if review == "APPROVED" else f"Nouvelle review : {repo}#{n}",
                     f"{title}\nrien à traiter", ["xdg-open", url])
            w.record(state, "feedback", repo, n, "notifié", f"{what} sans retour à traiter", title, at)
            state["feedback"][f"{repo}#{n}"] = at
    return todo, out


def guess_kind(state, repo, n):
    author = json.loads(w.run(["gh", "pr", "view", str(n), "--repo", repo, "--json", "author"]))
    return "feedback" if author["author"]["login"] == w.me(state) else "review"


w.configure(
    name="review-watch", env="REVIEW_WATCH", self_path=__file__,
    kinds=("review", "feedback"),
    skill={"review": "review:pr", "feedback": "review:feedback"},
    label={"review": "revue", "feedback": "retours"},
    tab={"review": "revue", "feedback": "retours"},
    defaults={"review": "notify", "feedback": "notify"},
    announce={"review": "Revue demandée", "feedback": "Nouveaux retours"},
    # Message à une session déjà ouverte sur la PR : elle ne voit pas seule ce qui arrive ensuite
    tell={
        "review": "review-watch : review redemandée sur la PR #{n}{when}. La PR a pu changer "
                  "depuis ta relecture : regarde les nouveaux commits avant de poster.",
        "feedback": "review-watch : nouveaux retours sur la PR #{n}{when}. Relis les fils non "
                    "résolus (requête de l'étape 2 de /review:feedback) et prends en compte ceux "
                    "qui ne sont pas dans ton analyse avant de répondre ou de relancer les relecteurs.",
    },
    guess_kind=guess_kind, worktrees="review-worktrees", detached=("review",),
    # États du tableau de gh-watch board pris en charge
    board={"to_review": "review", "re_requested": "review", "feedback": "feedback"},
)

if __name__ == "__main__":
    w.main(__doc__, events)
